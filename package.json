{
  "name": "phongb-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender",
    "build:pages": "node scripts/build-pages.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .prerender --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /phongb-space/",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/make-og-image.mjs",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/make-shots.mjs",
    "audit": "node scripts/audit.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "assets": "npm run icons && npm run og"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
